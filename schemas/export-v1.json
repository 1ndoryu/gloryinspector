{
  "schema": "inspector.schema/v1",
  "type": "object",
  "required": ["schema", "export_version", "provenance", "status", "classification", "findings", "assertions", "trace_id", "compatibility"],
  "properties": {
    "schema": {"const": "inspector.export/v1"},
    "export_version": {"const": 1},
    "provenance": {
      "type": "object",
      "required": ["fixture_id", "profile_id", "source", "tool_version"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "source": {"enum": ["mock", "import", "loopback", "authorized"]},
        "tool_version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["PASS", "WARN", "FAIL", "TOOL_ERROR", "NOT_RUN"]},
    "classification": {"type": ["string", "null"], "maxLength": 128},
    "findings": {"type": "array"},
    "assertions": {"type": "array"},
    "trace_id": {"type": ["string", "null"], "maxLength": 128},
    "input_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "trace_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "compatibility": {"type": "object", "required": ["contract", "supported_versions"], "properties": {"contract": {"const": "gloryapi-compatibility-adapter"}, "supported_versions": {"type": "array", "items": {"type": "integer"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
